{
  "name": "move-agent-chat",
  "version": "0.1.0",
  "description": "Move agent chat sessions between machines",
  "type": "module",
  "files": [
    "codex-plusplus/**/*",
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "!dist/__tests__",
    "scripts/**/*.mjs"
  ],
  "bin": {
    "move-agent-chat": "./dist/cli.js",
    "move-chat": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "install:codexpp-tweak": "node scripts/install-codexpp-tweak.mjs",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@clack/prompts": "^1.1.0",
    "commander": "^13.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
